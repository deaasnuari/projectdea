{
  "name": "lazispln-backend",
  "private": true,
  "version": "0.1.0",
  "description": "API konten situs LAZIS PLN Batam (Express + PostgreSQL)",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:clear-donations": "node scripts/clear-donations.js",
    "media:extract": "node scripts/migrate-media.js",
    "db:reset": "node scripts/migrate.js --reset && node scripts/seed.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  }
}
