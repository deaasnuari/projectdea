# Salin ke .env lalu sesuaikan.

# Koneksi PostgreSQL
DATABASE_URL=postgresql://lazispln:lazispln@localhost:5432/lazispln

# Origin frontend yang boleh akses API (untuk CORS + cookie)
FRONTEND_ORIGIN=http://localhost:3000

# Login admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Kunci untuk menandatangani cookie sesi — WAJIB diganti dengan string acak panjang
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang
