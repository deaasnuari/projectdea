# Salin ke .env lalu sesuaikan.

# Koneksi PostgreSQL
DATABASE_URL=postgresql://lazispln:lazispln@localhost:5432/lazispln

# Origin frontend yang boleh akses API (untuk CORS + cookie)
FRONTEND_ORIGIN=http://localhost:3000

# Login admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Kunci untuk menandatangani cookie sesi — WAJIB diganti dengan string acak panjang
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang

# Email — pesan formulir "Kontak Kami" diteruskan ke MAIL_TO (email LAZIS).
# SMTP_USER = akun Gmail pengirim, SMTP_PASS = App Password Gmail 16 huruf
# (bukan password login biasa): https://myaccount.google.com/apppasswords
# Kalau SMTP_USER/SMTP_PASS kosong, email dilewati (pesan tetap masuk Pesan Masuk admin).
MAIL_TO=email-lazis@contoh.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="Website LAZIS PLN Batam <akun-pengirim@gmail.com>"
